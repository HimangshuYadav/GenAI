# ==========================================
# HR Policy Assistant Configuration
# ==========================================

# Groq API Configuration (Required for Live LLM Responses)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ChromaDB & Embeddings Configuration
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHROMA_PERSIST_DIRECTORY=./chroma_db
PDF_PATH=./data/novapay_global_hr_manual_50p.pdf

# Retrieval Defaults
DEFAULT_TOP_K=5
DEFAULT_SIMILARITY_THRESHOLD=0.35

# Human Resources Contact Placeholder
HR_CONTACT_EMAIL=hr@company.com

